#!/usr/bin/env bash
# Builds a fresh Rails app, runs the authentication and tenanting generators, adds the
# account-scoped models and tests from test/integration/app and test/integration/<mode>,
# and runs the app's test suite.
#
#   bin/integration         # Accounts in the URL path
#   bin/integration domain  # Accounts on subdomains and custom domains
#   bin/integration cookie  # Accounts in a cookie
set -euo pipefail

MODE="${1:-path}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="${TMPDIR:-/tmp}/tenanting-integration-$MODE"

rm -rf "$APP"
cd "$(dirname "$APP")" # Outside any other Gemfile
rails new "$APP" --skip-git --skip-docker --skip-kamal --skip-thruster --skip-solid --skip-ci \
  --skip-brakeman --skip-rubocop --skip-bundle-audit --skip-dev-gems --skip-bundle > /dev/null
cd "$APP"

cat >> Gemfile <<GEMS
gem "tenanting", path: "$ROOT"
gem "json", "< 3" # json 3.0 breaks signed cookies in Rails 8.1
GEMS
bundle install --quiet

bin/rails generate authentication
bin/rails generate tenanting --account-from="$MODE"
bin/rails generate scaffold Project name:string account:references --quiet
bin/rails generate model Tag name:string account:references --quiet
bin/rails generate model Task title:string project:references tag:references --quiet
bin/rails generate model Comment body:string task:references --quiet
sed -i.bak 's/t.references :account, null: false/t.references :account, null: true/' db/migrate/*_create_tags.rb
sed -i.bak 's/t.references :tag, null: false/t.references :tag, null: true/' db/migrate/*_create_tasks.rb
rm db/migrate/*.bak
sed -i.bak 's/^  resources :projects$/  resources :projects\n  root "projects#index"/' config/routes.rb && rm config/routes.rb.bak
echo 'Rails.application.config.action_mailer.default_url_options = { host: "example.com" }' > config/initializers/mailer_host.rb
cp -R "$ROOT/test/integration/app/." .
cp -R "$ROOT/test/integration/$MODE/." .

bin/rails db:prepare > /dev/null
bin/rails test
